# Enforce LF line endings for shell/env/config scripts used by Xcode build on macOS
*.sh text eol=lf
ios/.xcode.env text eol=lf
ios/.xcode.env.local text eol=lf

# Common text files
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf

# Keep binary files untouched
*.png binary
*.jpg binary
*.ttf binary
